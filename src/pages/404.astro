---
import Layout from '../layouts/Layout.astro';
---

<Layout description="The requested page was not found." title="Page not found | CxxDbg">
  <!-- ====== 404 Section Start -->
  <section class="bg-white pt-[106px] pb-10 dark:bg-dark lg:pt-[132px] lg:pb-[60px]">
    <div class="container">
      <div class="mx-auto max-w-[600px] text-center">
        <h1
          class="mb-3 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]"
        >
          Page not found
        </h1>
        <p class="mb-8 text-base leading-relaxed text-body-color dark:text-dark-6">
          The requested page does not exist. It may have been moved or removed.
        </p>
        <a
          href="/"
          class="inline-flex items-center justify-center rounded-md bg-[#2563EB] py-3 px-7 text-base font-medium text-white transition duration-300 ease-in-out hover:bg-[#1D4ED8]"
        >
          Go to home page
        </a>
      </div>
    </div>
  </section>
  <!-- ====== 404 Section End -->
</Layout>
