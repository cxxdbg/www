---
import Layout from '../layouts/Layout.astro';
---

<Layout description="Download CxxDbg." title="Download | CxxDbg">
  <!-- ====== Download Section Start -->
  <section class="bg-white pt-[106px] pb-10 dark:bg-dark lg:pt-[132px] lg:pb-[60px]">
    <div class="container">
      <div class="mx-auto max-w-[800px] text-center">
        <h1
          class="mb-3 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]"
        >
          Download
        </h1>
        <p class="text-base leading-relaxed text-body-color dark:text-dark-6">
          Binary packages are coming soon.
        </p>
      </div>
    </div>
  </section>
  <!-- ====== Download Section End -->
</Layout>
