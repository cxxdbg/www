---
import { Code } from 'astro/components';
import {
  assetName,
  downloadUrl,
  release,
  releaseFileUrl,
  releaseUrl,
  marketplaceUrl,
  releasesUrl,
  vscodeAssetName,
} from '../config';

const build = (platform: string, extensions: string[]) =>
  extensions.map((extension) => ({
    name: assetName(platform, extension),
    url: downloadUrl(platform, extension),
  }));

const brewInstall = `brew tap cxxdbg/cxxdbg
brew install --cask cxxdbg`;

const sections = [
  { name: 'Linux', files: build('linux', ['deb', 'rpm', 'tar.bz2']) },
  { name: 'Windows', files: build('windows', ['zip']) },
  { name: 'macOS', files: build('macos', ['dmg', 'zip']), homebrew: true },
  {
    name: 'VS Code extension',
    files: [{ name: vscodeAssetName(), url: releaseFileUrl(vscodeAssetName()) }],
    marketplace: true,
  },
];
---

<!-- ====== Download Section Start -->
<section class="bg-white pt-[106px] pb-10 dark:bg-dark lg:pt-[132px] lg:pb-[60px]">
  <div class="container">
    <div class="-mx-4 flex flex-wrap">
      <div class="w-full px-4">
        <div class="mb-10 mx-auto max-w-[600px] text-center lg:mb-[60px]">
          <h1
            class="mb-3 text-3xl font-bold text-dark dark:text-white sm:text-4xl md:text-[40px] md:leading-[1.2]"
          >
            Download
          </h1>
          <p class="text-base leading-relaxed text-body-color dark:text-dark-6">
            CxxDbg {release.version} is available for Linux, Windows, and
            macOS. Release notes and the full list of files are on the
            <a
              href={releaseUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-primary hover:underline">release page</a
            >.
          </p>
        </div>
      </div>
    </div>

    <div class="mx-auto grid max-w-[700px] gap-4 sm:grid-cols-2">
      {
        sections.map((section) => (
          <div class="flex flex-col rounded-2xl border border-stroke bg-white p-6 shadow-1 dark:border-dark-3 dark:bg-dark">
            <h2 class="mb-4 text-lg font-bold text-dark dark:text-white">
              {section.name}
            </h2>
            <ul class="flex flex-col gap-2">
              {section.files.map((file) => (
                <li>
                  <a
                    href={file.url}
                    class="break-all font-mono text-sm text-primary hover:underline"
                  >
                    {file.name}
                  </a>
                </li>
              ))}
            </ul>
            {section.marketplace && (
              <div class="mt-4">
                <h3 class="mb-2 text-sm font-medium text-dark dark:text-white">
                  Install from Marketplace
                </h3>
                <a
                  href={marketplaceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-primary hover:underline"
                >
                  Visual Studio Marketplace
                </a>
              </div>
            )}
            {section.homebrew && (
              <div class="mt-4">
                <h3 class="mb-2 text-sm font-medium text-dark dark:text-white">
                  Install with Homebrew
                </h3>
                <Code
                  code={brewInstall}
                  lang="sh"
                  experimentalThemes={{ light: 'github-light', dark: 'github-dark' }}
                />
              </div>
            )}
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-body-color dark:text-dark-6">
      Earlier versions are available on the
      <a
        href={releasesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-primary hover:underline">releases page</a
      >.
    </p>
  </div>
</section>
<!-- ====== Download Section End -->
