---
interface Props {
  title: string;
  image: string;
  imageAlt?: string;
  imageSide?: 'left' | 'right';
}

const { title, image, imageAlt = 'CxxDbg screenshot', imageSide = 'right' } = Astro.props;
---

<div class="-mx-4 mb-16 flex flex-wrap items-center last:mb-0 lg:mb-20">
  <div class:list={['w-full px-4 lg:w-1/2', imageSide === 'left' && 'lg:order-2']}>
    <h3 class="mb-4 text-xl font-bold text-dark dark:text-white sm:text-2xl">
      {title}
    </h3>
    <div class="space-y-4 text-base leading-relaxed text-body-color dark:text-dark-6">
      <slot />
    </div>
  </div>
  <div class:list={['mt-8 w-full px-4 lg:mt-0 lg:w-1/2', imageSide === 'left' && 'lg:order-1']}>
    <div class="mx-auto w-fit max-w-full overflow-hidden rounded-xl border border-stroke p-2 shadow-1 dark:border-dark-3">
      <img src={image} alt={imageAlt} class="block h-auto max-w-full" />
    </div>
  </div>
</div>
